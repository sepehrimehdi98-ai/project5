{
  "name": "nova-python-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js server for the Nova Persian Python learning platform",
  "scripts": {
    "dev": "node scripts/dev-stack.js",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.js",
    "deploy:check": "node scripts/deploy-check.js",
    "test": "node --test --test-isolation=none",
    "db:migrate": "node scripts/migrate.js",
    "db:seed:courses": "node scripts/seed-courses.js",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "pyodide": "^314.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
