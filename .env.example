# Copy this file to .env and fill in values locally. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_HTTP_REFERER=http://127.0.0.1:3000
OPENROUTER_APP_TITLE=Nova Python Learning Platform
NODE_ENV=development

# Cloudinary is optional. Without these, the AI backend still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nova-demo/lessons
MEDIA_PROVIDER=cloudinary
PORT=3000

# Portable PostgreSQL connection. For Vercel + Supabase, copy the shared transaction
# pooler URL (port 6543) from Supabase's Connect dialog and store it in Vercel's
# private DATABASE_URL setting. URL-encode special characters in the DB password.
# Never use SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL in browser/VITE_ variables.
# Keep local, preview and production databases separate.
DATABASE_URL=
NOVA_DEMO_MODE=true
# Optional locally; required for the public no-database Vercel demo. Generate a long random value.
NOVA_DEMO_SESSION_SECRET=
DATABASE_SSL=require
# Optional provider CA certificate (PEM). Verification stays enabled when set.
DATABASE_CA_CERT=

# Set these temporarily only when creating the first real admin account.
# Remove them immediately after npm run db:bootstrap-admin succeeds.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

